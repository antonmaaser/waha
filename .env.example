# https://waha.devlike.pro/docs/how-to/config/
# Generate credentials with init-waha before starting the service.
WAHA_API_KEY=00000000000000000000000000000000
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=11111111111111111111111111111111
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=11111111111111111111111111111111
WAHA_DASHBOARD_ENABLED=True
# Automatic Dashboard authentication; no API key is exposed to JavaScript.
# Without Dashboard login, only same-origin browsers on localhost are accepted.
WAHA_DASHBOARD_AUTO_AUTH=True
# Session lifetime in seconds; active pages refresh it automatically.
# WAHA_DASHBOARD_SESSION_TTL=43200
WHATSAPP_SWAGGER_ENABLED=True

WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_BASE_URL=http://localhost:3000
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=False

WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media

# Optional runtime settings
# TZ=Europe/Berlin
# WHATSAPP_START_SESSION=default
# WHATSAPP_HOOK_URL=https://example.com/webhook
# WHATSAPP_HOOK_EVENTS=session.status,message
# GODEBUG=netdns=go

# Optional OAuth for the MCP app; see src/apps/mcp/oauth/README.md.
# WAHA_APPS_ENABLED=true
# WAHA_APPS_ON=mcp
# WAHA_MCP_OAUTH_ENABLED=true
# WAHA_MCP_OAUTH_ISSUER=https://auth.example.com/issuer
# WAHA_MCP_OAUTH_RESOURCE_URL=https://waha.example.com/mcp
# WAHA_MCP_OAUTH_SCOPES=waha:access
# WAHA_MCP_OAUTH_ALLOWED_ORIGINS=https://waha.example.com
# WAHA_MCP_OAUTH_ALLOW_INSECURE_HTTP=false
# Required when WAHA_API_KEY is a sha512: hash:
# WAHA_API_KEY_PLAIN=the-matching-plaintext-key
